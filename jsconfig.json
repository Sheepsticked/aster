{
  "_comment": "Aster — type-check plain JavaScript with JSDoc (tsc --noEmit); no emit, no TypeScript sources.",
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "checkJs": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "packages/controller/src/**/*.js",
    "packages/controller/bin/**/*.js",
    "packages/controller/test/**/*.js",
    "tools/**/*.js",
    "test/e2e/**/*.js"
  ],
  "exclude": ["node_modules", "dist", "packages/ui"]
}
