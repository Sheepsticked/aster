 			e->cmdsno = cmdsno;
 			e->cindex = 0;
 			e->cpvt = cpvt;
+			e->actionid[0] = '\0';
 
 			memcpy(&e->cmds[0], cmds, cmdsno * sizeof(*cmds));
 
@@ -315,6 +322,58 @@ EXPORT_DEF int at_queue_insert(struct cpvt * cpvt, at_queue_cmd_t * cmds, unsign
 	return at_queue_insert_uid(cpvt, cmds, cmdsno, athead, 0);
 }
 
+/*!
+ * \brief Add a task tagged with an AMI ActionID (QuectelAtCommand) and write it when it became the head
+ * \param cpvt -- cpvt structure
+ * \param cmds -- the commands; dynamic data is freed on failure as in at_queue_insert_uid()
+ * \param cmdsno -- number of commands
+ * \param athead -- non-0 insert after the current head
+ * \param actionid -- reported in the QuectelAtResponse and QuectelAtDone events of this task
+ * \return 0 on success non-0 on error; on error the task is not queued and no event was emitted
+ */
+#/* */
+EXPORT_DEF int at_queue_insert_actionid(struct cpvt * cpvt, at_queue_cmd_t * cmds, unsigned cmdsno, int athead, const char * actionid)
+{
+	unsigned idx;
+	at_queue_task_t *task = at_queue_add(cpvt, cmds, cmdsno, athead);
+
+	if(!task)
+	{
+		for(idx = 0; idx < cmdsno; idx++)
+		{
+			at_queue_free_data(&cmds[idx]);
+		}
+		return -1;
+	}
+
+	/* Only the head is written, and only when the queue was empty is that this task; a write error removes
+	   it again. The tag is set after the write, so a failed action never produces a QuectelAtDone. */
+	if (at_queue_run(cpvt->pvt))
+		return -1;
+
+	ast_copy_string(task->actionid, actionid, sizeof(task->actionid));
+	return 0;
+}
+
+/*!
+ * \brief Emit QuectelAtDone for the head task if it carries an ActionID, then clear the tag so that
+ *        nothing else is ever attributed to that ActionID
+ * \param pvt -- pvt structure
+ * \param result -- OK, ERROR or TIMEOUT
+ * \param error -- text for the Error: header, NULL for OK
+ */
+#/* */
+EXPORT_DEF void at_queue_actionid_done(struct pvt * pvt, const char * result, const char * error)
+{
+	at_queue_task_t * task = AST_LIST_FIRST (&pvt->at_queue);
+
+	if(task && task->actionid[0])
+	{
+		manager_event_at_done(PVT_ID(pvt), task->actionid, result, error);
+		task->actionid[0] = '\0';
+	}
+}
+
 
 
 #/* */
@@ -336,6 +395,8 @@ EXPORT_DEF void at_queue_flush (struct pvt* pvt)
 
 	while ((task = AST_LIST_FIRST (&pvt->at_queue)))
 	{
+		/* QuectelAtCommand tasks report the flush (disconnect, reset, restart) as their final result */
+		at_queue_actionid_done(pvt, "ERROR", "queue flushed");
 		at_queue_remove(pvt);
 	}
 }
