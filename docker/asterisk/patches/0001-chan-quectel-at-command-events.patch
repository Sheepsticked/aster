+/*!
+ * \brief Enqueue a user command tagged with an AMI ActionID (QuectelAtCommand)
+ * \param cpvt -- cpvt structure
+ * \param input -- the AT command line, sent verbatim followed by CR
+ * \param actionid -- reported in the QuectelAtResponse and QuectelAtDone events
+ * \param timeout_s -- seconds to wait for the final OK/ERROR line
+ * \return 0 on success
+ */
+EXPORT_DEF int at_enqueue_user_cmd_id(struct cpvt *cpvt, const char *input, const char *actionid, unsigned timeout_s)
+{
+	at_queue_cmd_t at_cmd = ATQ_CMD_DECLARE_DYNFT(CMD_USER, RES_OK, ATQ_CMD_FLAG_DEFAULT, timeout_s, 0);
+
+	if (at_fill_generic_cmd(&at_cmd, "%s\r", input) != 0 || at_queue_insert_actionid(cpvt, &at_cmd, 1, 1, actionid) != 0) {
+		chan_quectel_err = E_QUEUE;
+		return -1;
+	}
+	return 0;
+}
+
 /*!
  * \brief Start reading next SMS, if any
  * \param cpvt -- cpvt structure
