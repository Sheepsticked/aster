+/*!
+ * \brief Results the modem sends on its own (this fork also classifies REMOTE CALL END); they are never part of
+ *        the answer to a user command
+ * \param res -- result type
+ * \retval 1 unsolicited result
+ * \retval 0 anything else
+ */
+static int at_response_is_unsolicited (at_res_t res)
+{
+	switch (res)
+	{
+		case RES_BOOT:
+		case RES_RSSI:
+		case RES_MODE:
+		case RES_SRVST:
+		case RES_CSSI:
+		case RES_CSSU:
+		case RES_RING:
+		case RES_CEND:
+		case RES_CONN:
+		case RES_ORIG:
+		case RES_CONF:
+		case RES_RCEND:
+		case RES_CMTI:
+		case RES_CDSI:
+		case RES_SMMEMFULL:
+			return 1;
+		default:
+			return 0;
+	}
+}
