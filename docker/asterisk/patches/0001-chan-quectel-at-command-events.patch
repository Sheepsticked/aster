+/*!
+ * \brief Send a QuectelAtResponse event: one response line of a QuectelAtCommand task
+ * \param devname -- device name
+ * \param actionid -- ActionID of the QuectelAtCommand action
+ * \param line -- the response line; CR/LF are escaped as in manager_event_message()
+ */
+#/* */
+EXPORT_DEF void manager_event_at_response(const char * devname, const char * actionid, const char * line)
+{
+	char * escaped = espace_newlines(line);
+	if(escaped) {
+		manager_event (EVENT_FLAG_SYSTEM, "QuectelAtResponse",
+			"ActionID: %s\r\n"
+			"Device: %s\r\n"
+			"Line: %s\r\n",
+			actionid,
+			devname,
+			escaped
+		);
+		ast_free(escaped);
+	}
+}
+
+/*!
+ * \brief Send the QuectelAtDone event: the single final result of a QuectelAtCommand task
+ * \param devname -- device name
+ * \param actionid -- ActionID of the QuectelAtCommand action
+ * \param result -- OK, ERROR or TIMEOUT
+ * \param error -- the ERROR/+CMS ERROR/+CME ERROR line or a reason, NULL when result is OK
+ */
+#/* */
+EXPORT_DEF void manager_event_at_done(const char * devname, const char * actionid, const char * result, const char * error)
+{
+	char * escaped = NULL;
+	const char * text = "";
+
+	if(error) {
+		escaped = espace_newlines(error);
+		text = escaped ? escaped : "unknown";
+	}
+	manager_event (EVENT_FLAG_SYSTEM, "QuectelAtDone",
+		"ActionID: %s\r\n"
+		"Device: %s\r\n"
+		"Result: %s\r\n"
+		"%s%s%s",
+		actionid,
+		devname,
+		result,
+		error ? "Error: " : "", text, error ? "\r\n" : ""
+	);
+	if(escaped) {
+		ast_free(escaped);
+	}
+}
+
 #/* */
 EXPORT_DEF void manager_event_message(const char * event, const char * devname, const char * message)
 {
@@ -463,6 +519,88 @@ static int manager_reset (struct mansession* s, const struct message* m)
 	return 0;
 }
 
+static const char at_command_actionid_chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-";
+
+/*!
+ * \brief QuectelAtCommand: queue one AT command tagged with the action's ActionID; the result comes back as
+ *        QuectelAtResponse events (one per response line) and exactly one QuectelAtDone event. The request is
+ *        validated completely before the device is looked up, so a stopped device still reports a bad request.
+ */
+#/* */
+static int manager_at_command (struct mansession* s, const struct message* m)
+{
+	const char*	device	= astman_get_header (m, "Device");
+	const char*	command	= astman_get_header (m, "Command");
+	const char*	id	= astman_get_header (m, "ActionID");
+	const char*	timeout	= astman_get_header (m, "Timeout");
+
+	char		buf[256];
+	struct pvt*	pvt;
+	size_t		len;
+	unsigned	timeout_s = 15;
+	int		res;
+
+	len = strlen (id);
+	if (len < 1 || len > 63 || strspn (id, at_command_actionid_chars) != len)
+	{
+		astman_send_error (s, m, "Invalid ActionID");
+		return 0;
+	}
+
+	len = strlen (command);
+	if (len < 1 || len > 256 || strpbrk (command, "\r\n"))
+	{
+		astman_send_error (s, m, "Invalid Command");
+		return 0;
+	}
+
+	if (!ast_strlen_zero (timeout))
+	{
+		len = strlen (timeout);
+		if (len > 2 || strspn (timeout, "0123456789") != len || atoi (timeout) < 1 || atoi (timeout) > 60)
+		{
+			astman_send_error (s, m, "Invalid Timeout");
+			return 0;
+		}
+		timeout_s = atoi (timeout);
+	}
+
+	pvt = ast_strlen_zero (device) ? NULL : find_device (device);
+	if (!pvt)
+	{
+		astman_send_error (s, m, "Device not found");
+		return 0;
+	}
+
+	if (!pvt->connected)
+	{
+		ast_mutex_unlock (&pvt->lock);
+		astman_send_error (s, m, "Device not connected");
+		return 0;
+	}
+
+	if (!pvt->initialized)
+	{
+		ast_mutex_unlock (&pvt->lock);
+		astman_send_error (s, m, "Device not initialized");
+		return 0;
+	}
+
+	res = at_enqueue_user_cmd_id (&pvt->sys_chan, command, id, timeout_s);
+	ast_mutex_unlock (&pvt->lock);
+
+	if (res != 0)
+	{
+		astman_send_error (s, m, "Queue error");
+		return 0;
+	}
+
+	snprintf (buf, sizeof (buf), "[%s] AT command queued", device);
+	astman_send_ack (s, m, buf);
+
+	return 0;
+}
+
 static const char * const b_choices[] = { "now", "gracefully", "when convenient" };
