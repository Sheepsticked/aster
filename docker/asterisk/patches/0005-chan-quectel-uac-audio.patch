From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sheepsticked <72666364+Sheepsticked@users.noreply.github.com>
Date: Thu, 17 Sep 2026 00:00:00 +0000
Subject: [PATCH] uac: per-device audio state, rxgain/txgain, XRUN counts per
 call

Upstream: https://github.com/IchthysMaranatha/asterisk-chan-quectel @ 3d45c7f072131296a7e3c1a4faf5bb18751dbd87
Purpose: call audio of a device with `quec_uac = 1` (the modem's USB sound
         card): two such devices must not share one buffer, the volume
         settings must work as they do on the tty path, and a starved or
         overflowing sound card must leave a trace
         (applies on top of 0004)

The UAC branches of channel_read() and channel_write() were taken from
chan_alsa, a driver for one console sound card, together with its
function-static variables: the read frame, its buffer, the read position
and the write buffer. Every UAC device of the process used the same ones,
under its own lock, so two UAC calls at the same time each read pieces of
the other's audio and overwrote each other's write buffer.

- The read frame, its buffer and the read position live in struct pvt; the
  write buffer is a local of the call to channel_write() (it never carried
  anything from one call to the next: sizpos stayed 0). The position is
  reset at every connect and at every call start.
- rxgain and txgain are applied on the UAC path with the rules of the tty
  path: rxgain after the DTMF detector and to voice frames only, txgain to
  the copy that goes to the card (a gain between -1 and 1 changes nothing).
  Upstream read both settings and used them on the tty path alone.
- Capture overruns and playback underruns are counted per call and written
  as one verbose(3) line when the call's audio is switched off; upstream
  logs an XRUN only in a DEBUG build, so a log without them proved nothing.
  The playback side is taken out of the XRUN state the previous call's
  drain left it in when a call starts - channel_write() did that at its
  first frame - so that it does not count as an underrun of the new call.

No change for a device without quec_uac, no new setting, no change of the
ALSA parameters.
---
 chan_quectel.c |   2 +
 chan_quectel.h |   8 ++++
 channel.c      | 103 ++++++++++++++++++++++++++++++-------------------
 3 files changed, 73 insertions(+), 40 deletions(-)

diff --git a/chan_quectel.c b/chan_quectel.c
index 10a6138..835f498 100644
--- a/chan_quectel.c
+++ b/chan_quectel.c
@@ -209,6 +209,8 @@ static int soundcard_init(struct pvt * pvt)
 	ast_verb (2, "Sound Card %s Initialized\n", CONF_UNIQ(pvt, alsadev));
         snd_pcm_prepare(pvt->icard);
         snd_pcm_drop(pvt->icard);
+	pvt->uac_readpos = 0;
+	pvt->uac_left = FRAME_SIZE2;
 
 	return writedev;}
 
diff --git a/chan_quectel.h b/chan_quectel.h
index 97c0fe8..553252b 100644
--- a/chan_quectel.h
+++ b/chan_quectel.h
@@ -141,6 +141,14 @@ typedef struct pvt
 	pthread_t		monitor_thread;			/*!< monitor (at commands reader) thread handle */
 
         snd_pcm_t               *icard, *ocard;
+	/* UAC audio state of this device (Aster UAC patch). Upstream kept the read frame, its buffer and the read position in
+	 * function-static variables of channel_read(), shared by every UAC device of the process. */
+	struct ast_frame	uac_read_frame;
+	short			uac_read_buf[FRAME_SIZE2 + AST_FRIENDLY_OFFSET / 2];
+	int			uac_readpos;			/*!< samples of the frame being collected */
+	int			uac_left;			/*!< samples still missing from it */
+	unsigned int		uac_overruns;			/*!< capture XRUNs of the current call */
+	unsigned int		uac_underruns;			/*!< playback XRUNs of the current call */
 	int			audio_fd;			/*!< audio descriptor */
 	int			data_fd;			/*!< data descriptor */
 	char			* alock;			/*!< name of lockfile for audio */
diff --git a/channel.c b/channel.c
index 0d7e410..4993483 100644
--- a/channel.c
+++ b/channel.c
@@ -315,7 +315,11 @@ static void disactivate_call(struct cpvt* cpvt)
 
 	if(cpvt->channel && CPVT_TEST_FLAG(cpvt, CALL_FLAG_ACTIVATED))
 	{
-                if (strcmp(CONF_UNIQ(pvt, quec_uac),"1") == 0) snd_pcm_drop(pvt->icard);
+                if (strcmp(CONF_UNIQ(pvt, quec_uac),"1") == 0) {
+			snd_pcm_drop(pvt->icard);
+			/* the only trace of a starved or overflowing sound card: upstream logs an XRUN only in a DEBUG build */
+			ast_verb (3, "[%s] UAC audio of this call: %u capture overruns, %u playback underruns\n", PVT_ID(pvt), pvt->uac_overruns, pvt->uac_underruns);
+		}
 		else mixb_detach(&cpvt->pvt->a_write_mixb, &cpvt->mixstream);
 		ast_channel_set_fd (cpvt->channel, 1, -1);
 		ast_channel_set_fd (cpvt->channel, 0, -1);
@@ -371,6 +375,12 @@ static void activate_call(struct cpvt* cpvt)
                 snd_pcm_prepare(pvt->icard);
                 snd_pcm_start(pvt->icard);
                                                                                             }
+	        if (pvt->ocard && snd_pcm_state(pvt->ocard) == SND_PCM_STATE_XRUN)
+			snd_pcm_prepare(pvt->ocard);	/* channel_write() did this at its first frame; done here it is not counted as an underrun */
+	        pvt->uac_readpos = 0;
+	        pvt->uac_left = FRAME_SIZE2;
+	        pvt->uac_overruns = 0;
+	        pvt->uac_underruns = 0;
                       }                
 //		rb_init (&cpvt->a_write_rb, cpvt->a_write_buf, sizeof (cpvt->a_write_buf));
 //		cpvt->write = pvt->a_write_rb.write;
@@ -822,34 +832,27 @@ e_return:
 	return f;
         }
         else {
-	static struct ast_frame f;
-	static short __buf[FRAME_SIZE2 + AST_FRIENDLY_OFFSET / 2];
+	/* per device, not function-static (Aster UAC patch): two UAC devices in a call at the same time shared one frame, one
+	 * buffer and one read position, so each call read pieces of the other's audio */
+	struct ast_frame *const rf = &pvt->uac_read_frame;
 	short *buf;
-	static int readpos = 0;
-	static int left = FRAME_SIZE2;
 	snd_pcm_state_t state;
 	int r = 0;
 
-	f.frametype = AST_FRAME_NULL;
-	f.subclass.integer = 0;
-	f.samples = 0;
-	f.datalen = 0;
-	f.data.ptr = NULL;
-	f.offset = 0;
-	f.src = AST_MODULE;
-	f.mallocd = 0;
-	f.delivery.tv_sec = 0;
-	f.delivery.tv_usec = 0;
+	memset (rf, 0, sizeof (*rf));
+	rf->frametype = AST_FRAME_NULL;
+	rf->src = AST_MODULE;
 	state = snd_pcm_state(pvt->icard);
 	if ((state != SND_PCM_STATE_PREPARED) && (state != SND_PCM_STATE_RUNNING)) {
 		snd_pcm_prepare(pvt->icard);
 
 	}
 
-	buf = __buf + AST_FRIENDLY_OFFSET / 2;
+	buf = pvt->uac_read_buf + AST_FRIENDLY_OFFSET / 2;
 
-	r = snd_pcm_readi(pvt->icard, buf + readpos, left);
+	r = snd_pcm_readi(pvt->icard, buf + pvt->uac_readpos, pvt->uac_left);
 	if (r == -EPIPE) {
+		pvt->uac_overruns++;
 #if DEBUG
 		ast_log(LOG_ERROR, "XRUN read\n");
 #endif
@@ -864,34 +867,34 @@ e_return:
 	/* Return NULL frame on error */
 	if (r < 0) {
 		ast_mutex_unlock (&pvt->lock);
-		return &f;
+		return rf;
 	}
-	readpos += r;
-	left -= r;
+	pvt->uac_readpos += r;
+	pvt->uac_left -= r;
 
-	if (readpos >= FRAME_SIZE2) {
+	if (pvt->uac_readpos >= FRAME_SIZE2) {
 		/* A real frame */
-		readpos = 0;
-		left = FRAME_SIZE2;
+		pvt->uac_readpos = 0;
+		pvt->uac_left = FRAME_SIZE2;
 #if 0
                 if (ast_channel_state(channel) != AST_STATE_UP){
 			/* Don't transmit unless it's up */
 			ast_mutex_unlock(&pvt->lock);
-			return &f;
+			return rf;
 		}
 #endif
-		f.frametype = AST_FRAME_VOICE;
-		f.subclass.format = ast_format_slin;
-		f.samples = FRAME_SIZE2;
-		f.datalen = FRAME_SIZE2 * 2;
-		f.data.ptr = buf;
-		f.offset = AST_FRIENDLY_OFFSET;
-		f.src = AST_MODULE;
-		f.mallocd = 0;
+		rf->frametype = AST_FRAME_VOICE;
+		rf->subclass.format = ast_format_slin;
+		rf->samples = FRAME_SIZE2;
+		rf->datalen = FRAME_SIZE2 * 2;
+		rf->data.ptr = buf;
+		rf->offset = AST_FRIENDLY_OFFSET;
+		rf->src = AST_MODULE;
+		rf->mallocd = 0;
 		if (pvt->dsp)
 		{
                         struct ast_frame*	p;
-			p = ast_dsp_process (channel, pvt->dsp, &f);
+			p = ast_dsp_process (channel, pvt->dsp, rf);
 			if ((p->frametype == AST_FRAME_DTMF_END) || (p->frametype == AST_FRAME_DTMF_BEGIN))
 			{
 				if ((p->subclass_integer == 'm') || (p->subclass_integer == 'u'))
@@ -945,9 +948,18 @@ e_return:
 		}
 	}
 
+	/* rxgain as on the tty path: after the DTMF detector, voice only. Upstream read the setting and never applied it here. */
+	if (CONF_SHARED(pvt, rxgain) && rf->frametype == AST_FRAME_VOICE)
+	{
+		if (ast_frame_adjust_volume (rf, CONF_SHARED(pvt, rxgain)) == -1)
+		{
+			ast_debug (1, "[%s] Volume could not be adjusted!\n", PVT_ID(pvt));
+		}
+	}
+
 	ast_mutex_unlock (&pvt->lock);
 
-	return &f;
+	return rf;
         }
 
 }
@@ -1133,9 +1145,8 @@ e_return:
 	return 0;
              }
         else {
-	static char sizbuf[8000];
-	static int sizpos = 0;
-	int len = sizpos;
+	short sizbuf[4000];	/* of this call, not function-static: see channel_read() */
+	int len = 0;
 	int res = 0;
 	/* size_t frames = 0; */
 	snd_pcm_state_t state;
@@ -1145,19 +1156,31 @@ e_return:
 	{
 		CHANNEL_DEADLOCK_AVOIDANCE (channel);
 	}
-	if (f->datalen > sizeof(sizbuf) - sizpos) {
+	if (f->datalen > (int) sizeof(sizbuf)) {
 		ast_log(LOG_WARNING, "Frame too large\n");
 		res = -1;
 	} else {
-		memcpy(sizbuf + sizpos, f->data.ptr, f->datalen);
+		memcpy(sizbuf, f->data.ptr, f->datalen);
 		len += f->datalen;
+		/* txgain as on the tty path (a gain of -1..1 changes nothing), on the copy: the frame is the bridge's */
+		if (CONF_SHARED(pvt, txgain) > 1 || CONF_SHARED(pvt, txgain) < -1) {
+			struct ast_frame g = *f;
+
+			g.data.ptr = sizbuf;
+			g.mallocd = 0;
+			if (ast_frame_adjust_volume (&g, CONF_SHARED(pvt, txgain)) == -1)
+				ast_debug (1, "[%s] Volume could not be adjusted!\n", PVT_ID(pvt));
+		}
 		state = snd_pcm_state(pvt->ocard);
-		if (state == SND_PCM_STATE_XRUN)
+		if (state == SND_PCM_STATE_XRUN) {
+			pvt->uac_underruns++;
 			snd_pcm_prepare(pvt->ocard);
+		}
 		while ((res = snd_pcm_writei(pvt->ocard, sizbuf, len / 2)) == -EAGAIN) {
 			usleep(1);
 		}
 		if (res == -EPIPE) {
+			pvt->uac_underruns++;
 #if DEBUG
 			ast_debug(1, "XRUN write\n");
 #endif
