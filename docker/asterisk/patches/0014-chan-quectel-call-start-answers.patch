+/*!
+ * \brief Write the head command again when it is an AT+CLCC that got no answer in time: the answer may have been lost
+ *        on the USB, and the call state it asks for can be asked again at any time
+ * \param pvt -- pvt structure
+ * \return 1 when it was written again, 0 when the timeout stands
+ */
+#/* */
+EXPORT_DEF int at_queue_ask_again (struct pvt * pvt)
+{
+	at_queue_task_t * task = AST_LIST_FIRST (&pvt->at_queue);
+	at_queue_cmd_t * cmd = at_queue_head_cmd_nc(pvt);
+
+	if(!cmd || cmd->cmd != CMD_AT_CLCC || task->owed || cmd->length > 0 || !cmd->data || (cmd->flags & ATQ_CMD_FLAG_STATIC) == 0)
+		return 0;
+	if(at_write(pvt, cmd->data, strlen(cmd->data)))
+		return 0;
+	task->owed = 2;
+	cmd->timeout = ast_tvadd (ast_tvnow(), ast_tv(ATQ_CMD_TIMEOUT_AGAIN, 0));
+	return 1;
+}
+
+/*!
+ * \brief Take one final result of a command asked again; the first of its two results only starts a short wait for the
+ *        second, so that a late answer to the first write is not taken for the next command's
+ * \param pvt -- pvt structure
+ * \return 1 when the result was taken here, 0 when it completes the command as usual
+ */
+#/* */
+EXPORT_DEF int at_queue_take_owed (struct pvt * pvt)
+{
+	at_queue_task_t * task = AST_LIST_FIRST (&pvt->at_queue);
+	at_queue_cmd_t * cmd = at_queue_head_cmd_nc(pvt);
+
+	if(!cmd || task->owed < 2)
+		return 0;
+	task->owed = 1;
+	cmd->timeout = ast_tvadd (ast_tvnow(), ast_tv(ATQ_CMD_TIMEOUT_GRACE, 0));
+	return 1;
+}
+
+/*!
+ * \brief Whether the head command was asked again and got one of its two results: its timeout ends the wait for the other
+ * \param pvt -- pvt structure
+ */
+#/* */
+EXPORT_DEF int at_queue_head_answered (const struct pvt * pvt)
+{
+	const at_queue_task_t * task = at_queue_head_task(pvt);
+	return task && task->owed == 1;
+}
+
 /*!
  * \brief Write commands with queue
  * \param pvt -- pvt structure
