diff --git a/at_command.c b/at_command.c
index acd6239..62b736f 100644
--- a/at_command.c
+++ b/at_command.c
@@ -143,6 +143,13 @@ EXPORT_DEF int at_enqueue_initialization(struct cpvt *cpvt, at_cmd_t from_comman
 		ATQ_CMD_DECLARE_ST(CMD_AT, cmd_at),
 		ATQ_CMD_DECLARE_ST(CMD_AT_Z, cmd2),		/* optional,  reload configuration */
 		ATQ_CMD_DECLARE_ST(CMD_AT_E, cmd3),		/* disable echo */
+		/* radio = on|off (Aster radio patch): what the modem is set to now, then the setting; a switch takes seconds.
+		   IGNORE: an ERROR must not drop the rest of this task (at_queue_remove_cmd) — a failed AT+CFUN? leaves the decision
+		   to AT+CFUN=<n>, and a refused AT+CFUN=0 of a modem that is already off goes on with the identity; every error that
+		   has to stop the initialization disconnects explicitly (at_response_error) */
+		ATQ_CMD_DECLARE_STI(CMD_AT_CFUN_QUERY, "AT+CFUN?\r"),
+		ATQ_CMD_DECLARE_STIT(CMD_AT_CFUN_ON, "AT+CFUN=1\r", ATQ_CMD_TIMEOUT_RADIO, 0),
+		ATQ_CMD_DECLARE_STIT(CMD_AT_CFUN_OFF, "AT+CFUN=0\r", ATQ_CMD_TIMEOUT_RADIO, 0),
 		ATQ_CMD_DECLARE_DYN(CMD_AT_U2DIAG),		/* optional, Enable or disable some devices */
 		ATQ_CMD_DECLARE_ST(CMD_AT_CGMI, cmd5),		/* Getting manufacturer info */
 
@@ -174,6 +181,7 @@ EXPORT_DEF int at_enqueue_initialization(struct cpvt *cpvt, at_cmd_t from_comman
 		};
 	unsigned in, out;
 	int begin = -1;
+	int cgsn_passed = 0;
 	int err;
 	char * ptmp1 = NULL;
 	pvt_t * pvt = cpvt->pvt;
@@ -182,6 +190,11 @@ EXPORT_DEF int at_enqueue_initialization(struct cpvt *cpvt, at_cmd_t from_comman
 	/* customize list */
 	for(in = out = 0; in < ITEMS_OF(st_cmds); in++)
 	{
+		/* radio = off: nothing after the IMEI is sent, the device only stays connected (Aster radio patch) */
+		int identified = cgsn_passed;
+		if(st_cmds[in].cmd == CMD_AT_CGSN)
+			cgsn_passed = 1;
+
 		if(begin == -1)
 		{
 			if(st_cmds[in].cmd == from_command)
@@ -194,6 +207,14 @@ EXPORT_DEF int at_enqueue_initialization(struct cpvt *cpvt, at_cmd_t from_comman
 			continue;
 		if(st_cmds[in].cmd == CMD_AT_U2DIAG && CONF_SHARED(pvt, u2diag) == -1)
 			continue;
+		if(st_cmds[in].cmd == CMD_AT_CFUN_QUERY && CONF_SHARED(pvt, radio) == DC_RADIO_KEEP)
+			continue;
+		if(st_cmds[in].cmd == CMD_AT_CFUN_ON && CONF_SHARED(pvt, radio) != DC_RADIO_ON)
+			continue;
+		if(st_cmds[in].cmd == CMD_AT_CFUN_OFF && CONF_SHARED(pvt, radio) != DC_RADIO_OFF)
+			continue;
+		if(identified && CONF_SHARED(pvt, radio) == DC_RADIO_OFF)
+			continue;
 
 		memcpy(&cmds[out], &st_cmds[in], sizeof(st_cmds[in]));
 
