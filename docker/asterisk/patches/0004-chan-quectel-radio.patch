diff --git a/at_response.c b/at_response.c
index b808e4e..b89e7a7 100644
--- a/at_response.c
+++ b/at_response.c
@@ -234,6 +234,22 @@ static int at_response_ok (struct pvt* pvt, at_res_t res)
 				ast_debug (3, "[%s] %s sent successfully\n", PVT_ID(pvt), at_cmd2str (ecmd->cmd));
 				break;
 
+			case CMD_AT_CFUN_QUERY:
+				ast_debug (3, "[%s] %s sent successfully\n", PVT_ID(pvt), at_cmd2str (ecmd->cmd));
+				break;
+
+			case CMD_AT_CFUN_ON:
+				pvt->cfun = 1;
+				pvt->radio_reset = 0;
+				ast_verb (3, "[%s] Radio on (AT+CFUN=1)\n", PVT_ID(pvt));
+				break;
+
+			case CMD_AT_CFUN_OFF:
+				pvt->cfun = 0;
+				pvt->radio_off = 1;
+				ast_verb (3, "[%s] Radio off (AT+CFUN=0): the device stays connected and is not initialized\n", PVT_ID(pvt));
+				break;
+
 			case CMD_AT_COPS_INIT:
 				ast_debug (1, "[%s] Operator select parameters set\n", PVT_ID(pvt));
 				break;
@@ -509,6 +525,39 @@ static int at_response_error (struct pvt* pvt, at_res_t res, const char* str)
 				log_cmd_response_error(pvt, ecmd, "[%s] Error checking PIN state\n", PVT_ID(pvt));
 				goto e_return;
 
+			case CMD_AT_CFUN_QUERY:
+				/* not critical: the AT+CFUN=<n> that follows decides (Aster radio patch) */
+				log_cmd_response_error(pvt, ecmd, "[%s] Querying the radio functionality failed\n", PVT_ID(pvt));
+				break;
+
+			case CMD_AT_CFUN_ON:
+				if (pvt->cfun == 4 && !pvt->radio_reset)
+				{
+					/* Huawei firmware refuses AT+CFUN=1 in its offline mode (+CFUN: 4) and leaves that mode only through a
+					   reset. The reset is written at once (the initialization task is still the head of the queue) and the
+					   device reconnects after the modem is back. One reset until AT+CFUN=1 succeeds again, so a modem that
+					   keeps coming back offline is not reset in a loop. */
+					static const char reset[] = "AT+CFUN=1,1\r";
+
+					pvt->radio_reset = 1;
+					ast_log (LOG_WARNING, "[%s] Radio in offline mode (+CFUN: 4) refuses AT+CFUN=1: resetting the modem\n", PVT_ID(pvt));
+					at_write (pvt, reset, STRLEN (reset));
+					goto e_return;
+				}
+				log_cmd_response_error(pvt, ecmd, "[%s] Switching the radio on (AT+CFUN=1) failed\n", PVT_ID(pvt));
+				goto e_return;
+
+			case CMD_AT_CFUN_OFF:
+				if (pvt->cfun == 0 || pvt->cfun == 4)
+				{
+					/* already off: Huawei firmware refuses AT+CFUN=0 in its offline mode (+CFUN: 4) */
+					pvt->radio_off = 1;
+					ast_verb (3, "[%s] Radio already off (+CFUN: %d): the device stays connected and is not initialized\n", PVT_ID(pvt), pvt->cfun);
+					break;
+				}
+				log_cmd_response_error(pvt, ecmd, "[%s] Switching the radio off (AT+CFUN=0) failed\n", PVT_ID(pvt));
+				goto e_return;
+
 			case CMD_AT_COPS_INIT:
 				log_cmd_response_error(pvt, ecmd, "[%s] Error setting operator select parameters\n", PVT_ID(pvt));
 				goto e_return;
@@ -1794,6 +1843,29 @@ static int at_response_cusd (struct pvt * pvt, char * str, size_t len)
 	return 0;
 }
 
+/*!
+ * \brief Handle +CFUN response: remember the radio functionality the modem reports (Aster radio patch)
+ * \param pvt -- pvt structure
+ * \param str -- string containing response (null terminated)
+ * \retval  0 success
+ */
+
+static int at_response_cfun (struct pvt* pvt, const char* str)
+{
+	int fun;
+
+	if (sscanf (str, "+CFUN:%d", &fun) == 1)
+	{
+		pvt->cfun = fun;
+		ast_debug (1, "[%s] Radio functionality %d\n", PVT_ID(pvt), fun);
+	}
+	else
+	{
+		ast_debug (1, "[%s] Error parsing +CFUN message: %s\n", PVT_ID(pvt), str);
+	}
+	return 0;
+}
+
 /*!
  * \brief Handle +CPIN response
  * \param pvt -- pvt structure
@@ -2227,6 +2299,11 @@ int at_response (struct pvt* pvt, const struct iovec iov[2], int iovcnt, at_res_
 
                                return 0;
 
+			case RES_CFUN:
+				/* radio functionality (Aster radio patch): an error here is not fatal */
+				at_response_cfun (pvt, str);
+				return 0;
+
 			case RES_CPIN:
 				/* fatal */
 				return at_response_cpin (pvt, str, len);
