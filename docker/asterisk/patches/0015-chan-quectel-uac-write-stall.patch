 		ast_channel_set_fd (cpvt->channel, 1, -1);
@@ -392,6 +392,9 @@ static void activate_call(struct cpvt* cpvt)
 	        pvt->uac_underruns = 0;
 	        pvt->uac_xrun_streak = 0;
 	        pvt->uac_reopens = 0;
+	        pvt->uac_drops = 0;
+	        pvt->uac_stall_streak = 0;
+	        pvt->uac_stall_reopen_at = UAC_STALL_STREAK_REOPEN;
                       }
 //		rb_init (&cpvt->a_write_rb, cpvt->a_write_buf, sizeof (cpvt->a_write_buf));
 //		cpvt->write = pvt->a_write_rb.write;
@@ -975,6 +978,41 @@ e_return:
 
 }
 
+/* Writes one frame to the playback stream without waiting more than a frame time for room (the caller holds the device
+ * lock); a frame that still does not fit is dropped and counted. */
+static int uac_playback_write (struct pvt* pvt, const short* buf, snd_pcm_uframes_t frames)
+{
+	unsigned int waits = pvt->uac_stall_streak ? 0 : UAC_WRITE_WAIT_MS;
+	int res;
+
+	while ((res = snd_pcm_writei(pvt->ocard, buf, frames)) == -EAGAIN) {
+		if (waits == 0)
+			break;
+		waits--;
+		usleep(1000);
+	}
+	if (res >= 0) {
+		pvt->uac_stall_streak = 0;
+		pvt->uac_stall_reopen_at = UAC_STALL_STREAK_REOPEN;
+	}
+	if (res != -EAGAIN)
+		return res;
+
+	pvt->uac_drops++;
+	pvt->uac_stall_streak++;
+	return frames;
+}
+
+/* True when the playback buffer stayed full for UAC_STALL_STREAK_REOPEN frames in a row, then every UAC_STALL_REOPEN_RETRY
+ * more: a stream the kernel's USB audio driver left stuck only runs again on a reopened card. */
+static int uac_stall_reopen_due (struct pvt* pvt)
+{
+	if (pvt->uac_stall_streak == 0 || pvt->uac_stall_streak < pvt->uac_stall_reopen_at)
+		return 0;
+	pvt->uac_stall_reopen_at = pvt->uac_stall_streak + UAC_STALL_REOPEN_RETRY;
+	return 1;
+}
+
 #/* */
 static int channel_write (struct ast_channel* channel, struct ast_frame* f)
 {
@@ -1159,6 +1197,7 @@ e_return:
 	short sizbuf[4000];	/* of this call, not function-static: see channel_read() */
 	int len = 0;
 	int res = 0;
+	int reopen;
 	/* size_t frames = 0; */
 	snd_pcm_state_t state;
 
@@ -1187,10 +1226,17 @@ e_return:
 		 * reaching the modem — the far end hears nothing while the device looks fine (seen with an EC25 on Linux
 		 * 6.18's snd_usb_audio in its low-latency mode). Closing and reopening the card once gives the driver a fresh
 		 * stream, which is what a `quectel restart` did by hand; the count goes to the per-call line either way. */
+		reopen = 0;
 		if (pvt->uac_xrun_streak >= UAC_XRUN_STREAK_REOPEN && pvt->uac_reopens == 0) {
-			pvt->uac_reopens++;
 			ast_log(LOG_WARNING, "[%s] the playback stream does not run (%u writes in a row ended in XRUN, nothing reaches the modem): reopening the sound card\n", PVT_ID(pvt), pvt->uac_xrun_streak);
 			pvt->uac_xrun_streak = 0;
+			reopen = 1;
+		} else if (uac_stall_reopen_due(pvt)) {	/* the same for a playback buffer that stays full */
+			ast_log(LOG_WARNING, "[%s] the playback buffer stays full, nothing reaches the modem (%u frames in a row dropped): reopening the sound card\n", PVT_ID(pvt), pvt->uac_stall_streak);
+			reopen = 1;
+		}
+		if (reopen) {
+			pvt->uac_reopens++;
 			if (soundcard_reopen(pvt) == 0) {
 				snd_pcm_prepare(pvt->icard);
 				snd_pcm_start(pvt->icard);
@@ -1212,9 +1258,7 @@ e_return:
 		} else if (state != SND_PCM_STATE_PREPARED && state != SND_PCM_STATE_RUNNING) {
 			snd_pcm_prepare(pvt->ocard);	/* SETUP would answer -EBADFD; see activate_call() */
 		}
-		while ((res = snd_pcm_writei(pvt->ocard, sizbuf, len / 2)) == -EAGAIN) {
-			usleep(1);
-		}
+		res = uac_playback_write(pvt, sizbuf, len / 2);
 		if (res == -EPIPE) {
 			pvt->uac_underruns++;
 			pvt->uac_xrun_streak++;
@@ -1222,9 +1266,7 @@ e_return:
 			ast_debug(1, "XRUN write\n");
 #endif
 			snd_pcm_prepare(pvt->ocard);
-			while ((res = snd_pcm_writei(pvt->ocard, sizbuf, len / 2)) == -EAGAIN) {
-				usleep(1);
-			}
+			res = uac_playback_write(pvt, sizbuf, len / 2);
 			if (res != len / 2) {
 				ast_log(LOG_ERROR, "Write error: %s\n", snd_strerror(res));
 				res = -1;
