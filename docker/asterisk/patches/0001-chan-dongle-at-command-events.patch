+/*!
+ * \brief Send a DongleAtResponse event: one response line of a DongleAtCommand task
+ * \param devname -- device name
+ * \param actionid -- ActionID of the DongleAtCommand action
+ * \param line -- the response line; CR/LF are escaped as in manager_event_message()
+ */
+#/* */
+EXPORT_DEF void manager_event_at_response(const char * devname, const char * actionid, const char * line)
+{
+	char * escaped = espace_newlines(line);
+	if(escaped) {
+		manager_event (EVENT_FLAG_SYSTEM, "DongleAtResponse",
+			"ActionID: %s\r\n"
+			"Device: %s\r\n"
+			"Line: %s\r\n",
+			actionid,
+			devname,
+			escaped
+		);
+		ast_free(escaped);
+	}
+}
+
+/*!
+ * \brief Send the DongleAtDone event: the single final result of a DongleAtCommand task
+ * \param devname -- device name
+ * \param actionid -- ActionID of the DongleAtCommand action
+ * \param result -- OK, ERROR or TIMEOUT
+ * \param error -- the ERROR/+CMS ERROR/+CME ERROR line or a reason, NULL when result is OK
+ */
+#/* */
+EXPORT_DEF void manager_event_at_done(const char * devname, const char * actionid, const char * result, const char * error)
+{
+	char * escaped = NULL;
+	const char * text = "";
+
+	if(error) {
+		escaped = espace_newlines(error);
+		text = escaped ? escaped : "unknown";
+	}
+	manager_event (EVENT_FLAG_SYSTEM, "DongleAtDone",
+		"ActionID: %s\r\n"
+		"Device: %s\r\n"
+		"Result: %s\r\n"
+		"%s%s%s",
+		actionid,
+		devname,
+		result,
+		error ? "Error: " : "", text, error ? "\r\n" : ""
+	);
+	if(escaped) {
+		ast_free(escaped);
+	}
+}
+
 #/* */
 EXPORT_DEF void manager_event_message(const char * event, const char * devname, const char * message)
 {
@@ -461,6 +517,88 @@ static int manager_reset (struct mansession* s, const struct message* m)
 	return 0;
 }
 
+static const char at_command_actionid_chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-";
+
+/*!
+ * \brief DongleAtCommand: queue one AT command tagged with the action's ActionID; the result comes back as
+ *        DongleAtResponse events (one per response line) and exactly one DongleAtDone event. The request is
+ *        validated completely before the device is looked up, so a stopped device still reports a bad request.
+ */
+#/* */
+static int manager_at_command (struct mansession* s, const struct message* m)
+{
+	const char*	device	= astman_get_header (m, "Device");
+	const char*	command	= astman_get_header (m, "Command");
+	const char*	id	= astman_get_header (m, "ActionID");
+	const char*	timeout	= astman_get_header (m, "Timeout");
+
+	char		buf[256];
+	struct pvt*	pvt;
+	size_t		len;
+	unsigned	timeout_s = 15;
+	int		res;
+
+	len = strlen (id);
+	if (len < 1 || len > 63 || strspn (id, at_command_actionid_chars) != len)
+	{
+		astman_send_error (s, m, "Invalid ActionID");
+		return 0;
+	}
+
+	len = strlen (command);
+	if (len < 1 || len > 256 || strpbrk (command, "\r\n"))
+	{
+		astman_send_error (s, m, "Invalid Command");
+		return 0;
+	}
+
+	if (!ast_strlen_zero (timeout))
+	{
+		len = strlen (timeout);
+		if (len > 2 || strspn (timeout, "0123456789") != len || atoi (timeout) < 1 || atoi (timeout) > 60)
+		{
+			astman_send_error (s, m, "Invalid Timeout");
+			return 0;
+		}
+		timeout_s = atoi (timeout);
+	}
+
+	pvt = ast_strlen_zero (device) ? NULL : find_device (device);
+	if (!pvt)
+	{
+		astman_send_error (s, m, "Device not found");
+		return 0;
+	}
+
+	if (!pvt->connected)
+	{
+		ast_mutex_unlock (&pvt->lock);
+		astman_send_error (s, m, "Device not connected");
+		return 0;
+	}
+
+	if (!pvt->initialized)
+	{
+		ast_mutex_unlock (&pvt->lock);
+		astman_send_error (s, m, "Device not initialized");
+		return 0;
+	}
+
+	res = at_enqueue_user_cmd_id (&pvt->sys_chan, command, id, timeout_s);
+	ast_mutex_unlock (&pvt->lock);
+
+	if (res != 0)
+	{
+		astman_send_error (s, m, "Queue error");
+		return 0;
+	}
+
+	snprintf (buf, sizeof (buf), "[%s] AT command queued", device);
+	astman_send_ack (s, m, buf);
+
+	return 0;
+}
+
 static const char * const b_choices[] = { "now", "gracefully", "when convenient" };
 #/* */
 static int manager_restart_action(struct mansession * s, const struct message * m, dev_state_t event)
@@ -669,6 +807,26 @@ static const struct dongle_manager
 	"	ActionID: <id>		Action ID for this transaction. Will be returned.\n"
 	"	*When:    < now | gracefully | when convenient > Time when devices reconfigured.\n"
 	},
+	{
+	manager_at_command,
+	EVENT_FLAG_SYSTEM,
+	"DongleAtCommand",
+	"Send an AT command to a dongle and get its responses as AMI events.",
+	"Description: Send one AT command to a connected and initialized dongle. The command is queued\n"
+	"ahead of other pending commands. Every response line arrives as a DongleAtResponse event\n"
+	"(Line: <text>); the final result arrives as exactly one DongleAtDone event with\n"
+	"Result: OK | ERROR | TIMEOUT and Error: <text> unless OK. Both events carry the ActionID and\n"
+	"Device of this action. A queue flush (disconnect, reset, restart) ends a pending command with\n"
+	"Result: ERROR. A timeout is reported first and then handled as usual: the dongle is\n"
+	"disconnected and restarted.\n\n"
+	"Variables: (Names marked with * are required)\n"
+	"	*ActionID: <id>		1-63 characters [A-Za-z0-9._-]; returned in the response and in the events.\n"
+	"	*Device:   <device>	The dongle that receives the command; must be connected and initialized.\n"
+	"	*Command:  <AT line>	1-256 characters, no CR or LF; sent verbatim followed by CR.\n"
+	"	Timeout:   <seconds>	1-60, default 15; the wait for the final OK/ERROR line.\n"
+	"Errors: Invalid ActionID, Invalid Command, Invalid Timeout, Device not found, Device not connected,\n"
+	"Device not initialized, Queue error.\n"
+	},
 };
 
