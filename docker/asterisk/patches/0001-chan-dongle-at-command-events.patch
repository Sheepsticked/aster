diff --git a/at_response.c b/at_response.c
index 1832dae..2ec184c 100644
--- a/at_response.c
+++ b/at_response.c
@@ -62,6 +62,36 @@ EXPORT_DEF const char* at_res2str (at_res_t res)
 	return "UNDEFINED";
 }
 
+/*!
+ * \brief Results the dongle sends on its own; they are never part of the answer to a user command
+ * \param res -- result type
+ * \retval 1 unsolicited result
+ * \retval 0 anything else
+ */
+static int at_response_is_unsolicited (at_res_t res)
+{
+	switch (res)
+	{
+		case RES_BOOT:
+		case RES_RSSI:
+		case RES_MODE:
+		case RES_SRVST:
+		case RES_CSSI:
+		case RES_CSSU:
+		case RES_RING:
+		case RES_CEND:
+		case RES_CONN:
+		case RES_ORIG:
+		case RES_CONF:
+		case RES_CMTI:
+		case RES_CDSI:
+		case RES_SMMEMFULL:
+			return 1;
+		default:
+			return 0;
+	}
+}
+
 /*!
  * \brief Handle OK response
  * \param pvt -- pvt structure
@@ -250,6 +280,8 @@ static int at_response_ok (struct pvt* pvt, at_res_t res)
 				}
 				break;
 			case CMD_USER:
+				/* a DongleAtCommand task ends here; nothing to do for a CLI command */
+				at_queue_actionid_done (pvt, "OK", NULL);
 				break;
 			default:
 				ast_log (LOG_ERROR, "[%s] Received 'OK' for unhandled command '%s'\n", PVT_ID(pvt), at_cmd2str (ecmd->cmd));
@@ -289,13 +321,15 @@ static void log_cmd_response_error(const struct pvt* pvt, const at_queue_cmd_t *
 }
 
 /*!
- * \brief Handle ERROR response
+ * \brief Handle ERROR, +CMS ERROR and +CME ERROR responses
  * \param pvt -- pvt structure
+ * \param res -- result type
+ * \param str -- the response line (null terminated), reported by DongleAtDone for a DongleAtCommand task
  * \retval  0 success
  * \retval -1 error
  */
 
-static int at_response_error (struct pvt* pvt, at_res_t res)
+static int at_response_error (struct pvt* pvt, at_res_t res, const char* str)
 {
 	const at_queue_task_t * task = at_queue_head_task(pvt);
 	const at_queue_cmd_t * ecmd = at_queue_task_cmd(task);
@@ -504,6 +538,15 @@ static int at_response_error (struct pvt* pvt, at_res_t res)
 				log_cmd_response_error(pvt, ecmd, "[%s] Error sending USSD %p\n", PVT_ID(pvt), task);
 				break;
 
+			case CMD_USER:
+				if (task->actionid[0])
+				{
+					/* the AMI client asked for this command and gets the result; not an error of the dongle */
+					ast_debug (1, "[%s] User's command failed: '%s'\n", PVT_ID(pvt), str);
+					at_queue_actionid_done (pvt, "ERROR", str);
+					break;
+				}
+				/* fall through */
 			default:
 				log_cmd_response_error(pvt, ecmd, "[%s] Received 'ERROR' for unhandled command '%s'\n", PVT_ID(pvt), at_cmd2str (ecmd->cmd));
 				break;
@@ -1806,6 +1849,12 @@ int at_response (struct pvt* pvt, const struct iovec iov[2], int iovcnt, at_res_
 		if(ecmd && ecmd->cmd == CMD_USER) {
 			ast_verb(1, "[%s] Got Response for user's command:'%s'\n", PVT_ID(pvt), str);
 			ast_log(LOG_NOTICE, "[%s] Got Response for user's command:'%s'\n", PVT_ID(pvt), str);
+			/* DongleAtCommand task: every line that is neither the final result nor unsolicited is a response line;
+			   the final result is reported by at_response_ok() / at_response_error() through at_queue_actionid_done() */
+			if(task->actionid[0] && at_res != RES_OK && at_res != RES_ERROR && at_res != RES_CMS_ERROR && at_res != RES_CME_ERROR
+				&& !at_response_is_unsolicited(at_res)) {
+				manager_event_at_response(PVT_ID(pvt), task->actionid, str);
+			}
 		}
 		switch (at_res)
 		{
@@ -1881,8 +1930,9 @@ int at_response (struct pvt* pvt, const struct iovec iov[2], int iovcnt, at_res_
 				break;
 
 			case RES_CMS_ERROR:
+			case RES_CME_ERROR:
 			case RES_ERROR:
-				return at_response_error (pvt, at_res);
+				return at_response_error (pvt, at_res, str);
 
 			case RES_RING:
 				return at_response_ring (pvt);
