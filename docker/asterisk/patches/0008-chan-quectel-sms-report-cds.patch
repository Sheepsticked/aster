+EXPORT_DEF ssize_t rb_find_nth_crlf (const struct ringbuffer* rb, unsigned n)
+{
+	size_t	i;
+	int	prev_cr = 0;
+
+	for (i = 0; i < rb->used; ++i)
+	{
+		char c = ((const char*) rb->buffer)[(rb->read + i) % rb->size];
+
+		if (prev_cr && c == '\n' && --n == 0)
+		{
+			return (ssize_t) (i - 1);
+		}
+		prev_cr = (c == '\r');
+	}
+
+	return -1;
+}
