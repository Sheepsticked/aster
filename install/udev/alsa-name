#!/bin/sh
# Aster — alsa-name: print a deterministic ALSA card id for a Quectel sound card from its udev devpath.
# Usage: alsa-name <devpath>      e.g. /devices/platform/scb/fd500000.pcie/pci0000:00/.../usb1/1-1/1-1.3/1-1.3:1.4/sound/card2
# Output: q_<port with - and . replaced by _>   e.g. q_1_1_3; if longer than 15 chars: qh_<first 12 hex of sha1(port)>
# Exit 1 when no USB port segment is found (udev then leaves the id unchanged).
set -eu
devpath=${1:-}
port=""
# Walk the path segments; the last one matching <bus>-<port[.port...]> (without a ':<config>.<iface>' suffix) is the device port.
IFS=/
for seg in $devpath; do
  case "$seg" in
    *:*) ;;                                   # interface segment, e.g. 1-1.3:1.4 — skip
    [0-9]*-[0-9]*) port=$seg ;;               # device segment, e.g. 1-1.3
  esac
done
unset IFS
[ -n "$port" ] || { echo "alsa-name: no usb port in devpath: $devpath" >&2; exit 1; }
name="q_$(printf '%s' "$port" | tr '.-' '__')"
if [ ${#name} -gt 15 ]; then
  hash=$(printf '%s' "$port" | sha1sum | cut -c1-12)
  name="qh_$hash"
fi
printf '%s\n' "$name"
