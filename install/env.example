# Aster — the appliance's environment: install.sh writes it from this template as .env beside docker-compose.yml,
# which compose reads by itself. The data goes to ASTER_HOME below (data/ by default).
ASTER_VERSION=latest           # the tag the published images carry; a local build writes dev instead
ASTER_HTTP_PORT=80
# pull = the published ASTER_IMAGE_NS/aster-{asterisk,controller}:ASTER_VERSION images; build = build from ASTER_REPO.
# install.sh --build/--pull writes this line, and `aster update` follows it.
ASTER_IMAGE_SOURCE=pull
ASTER_IMAGE_NS=sheepsticked    # the Docker Hub account the images are published to (a local build writes aster/)
# Where the checkout and the home were when install.sh ran (relative paths are resolved from the compose file). The
# aster command passes both itself, from where it really is, so these two only matter to a docker compose run by hand.
ASTER_REPO=..
ASTER_HOME=../data
